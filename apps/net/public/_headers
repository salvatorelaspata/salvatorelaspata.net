# Header per gli asset statici su Cloudflare (Workers static assets / Pages).
# Allineati a apps/dev/public/_headers e a nginx/nginx.conf (immagini Docker).
# GitHub Pages e nginx non leggono questo file.
# Nessuno script di terze parti: le prenotazioni Cal.com sono link diretti.
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'

# vCard scaricabile e inquadrabile dal QR code della sezione Contatti
/salvatore-la-spata.vcf
  Content-Type: text/vcard; charset=utf-8
  Content-Disposition: attachment; filename="salvatore-la-spata.vcf"
/en/salvatore-la-spata.vcf
  Content-Type: text/vcard; charset=utf-8
  Content-Disposition: attachment; filename="salvatore-la-spata.vcf"
