---
// Home one-page, condivisa da / e /en/.
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from './Hero.astro'
import About from './About.astro'
import TechList from './TechList.astro'
import ProjectCard from './ProjectCard.astro'
import ProjectRow from './ProjectRow.astro'
import Filter from './Filter.astro'
import Timeline from './Timeline.astro'
import BlogCard from './BlogCard.astro'
import Contact from './Contact.astro'
import Icon from './Icon.astro'
import { useT, toLang, fmt, href } from '../i18n'
import { getProjects, getExperiences } from '@salvatorelaspata/content/util'
import { PROJECT_FILTERS } from '@salvatorelaspata/content/types'
import { getPosts } from '../lib/blog'
import { profile } from '@salvatorelaspata/content/profile'

const lang = toLang(Astro.currentLocale)
const t = useT(lang)

const projects = getProjects(lang)
const featured = projects.filter(p => p.featured)
const filterOptions = [
  { value: 'all', label: t.projects.filters.all, count: projects.length },
  ...PROJECT_FILTERS.map(f => ({
    value: f,
    label: t.projects.filters[f],
    count: projects.filter(p => p.filters.includes(f)).length,
  })).filter(o => o.count > 0),
]
const experiences = getExperiences(lang)
const latestPosts = (await getPosts(lang)).slice(0, 3)

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.fullName,
  givenName: profile.firstName,
  familyName: profile.lastName,
  jobTitle: profile.role[lang],
  worksFor: { '@type': 'Organization', name: profile.company, url: profile.companyUrl },
  email: `mailto:${profile.email}`,
  url: profile.site,
  sameAs: [profile.github, profile.linkedin],
  address: { '@type': 'PostalAddress', addressLocality: profile.city[lang], addressCountry: profile.countryCode },
}
---

<BaseLayout jsonLd={personJsonLd}>
  <Hero projectCount={projects.length} />
  <About />
  <TechList />

  <section id={t.ids.projects} class='section' aria-labelledby='proj-title'>
    <div class='container-site'>
      <div class='max-w-2xl' data-reveal>
        <p class='eyebrow'>{t.ids.projects}</p>
        <h2 id='proj-title' class='t-h2 mt-3'>{t.projects.title}</h2>
        <p class='t-lead mt-4'>{fmt(t.projects.lead, { n: projects.length })}</p>
      </div>
      <h3 class='label-mono mt-12'>{t.projects.featured}</h3>
      <ul class='mt-4 grid gap-6 md:grid-cols-2' data-reveal-group>
        {featured.map(project => <ProjectCard project={project} />)}
      </ul>

      <div class='mt-20'>
        <div class='flex flex-wrap items-baseline justify-between gap-3'>
          <h3 class='t-h3'>{t.projects.all}</h3>
          <p
            class='font-mono text-step--1 text-muted'
            data-filter-status='projects'
            data-template={t.projects.count}
            aria-live='polite'
          >
            {fmt(t.projects.count, { n: projects.length })}
          </p>
        </div>
        <Filter group='projects' label={t.projects.filterLabel} options={filterOptions} />
        <ul class='mt-4 divide-y divide-line-subtle border-y-2 border-line'>
          {projects.map(project => <ProjectRow project={project} />)}
        </ul>
        <p data-filter-empty='projects' hidden class='py-8 text-muted'>{t.projects.empty}</p>
      </div>
    </div>
  </section>

  <section id={t.ids.experience} class='section' aria-labelledby='exp-title'>
    <div class='container-site grid gap-12 lg:grid-cols-12'>
      <div class='lg:col-span-4' data-reveal>
        <div class='lg:sticky lg:top-28'>
          <p class='eyebrow'>{t.ids.experience}</p>
          <h2 id='exp-title' class='t-h2 mt-3'>{t.experience.title}</h2>
          <p class='t-lead mt-4'>{t.experience.lead}</p>
        </div>
      </div>
      <Timeline experiences={experiences} />
    </div>
  </section>

  {
    latestPosts.length > 0 && (
      <section id={t.ids.blog} class='section' aria-labelledby='blog-title'>
        <div class='container-site'>
          <div class='flex flex-wrap items-end justify-between gap-6' data-reveal>
            <div class='max-w-2xl'>
              <p class='eyebrow'>{t.ids.blog}</p>
              <h2 id='blog-title' class='t-h2 mt-3'>{t.blog.homeTitle}</h2>
            </div>
            <a class='btn' href={href('/blog/', lang)}>
              {t.blog.allPosts}
              <Icon name='arrow-right' />
            </a>
          </div>
          <ul class='mt-10 grid gap-6 md:grid-cols-3' data-reveal-group>
            {latestPosts.map(post => <BlogCard post={post} />)}
          </ul>
        </div>
      </section>
    )
  }

  <Contact />
</BaseLayout>
