---
import Icon from './Icon.astro'
import Logo from './Logo.astro'
import LangSwitch from './LangSwitch.astro'
import { useT, toLang, href, sectionHref, mainNav } from '../i18n'
import { profile, mailto } from '@salvatorelaspata/content/profile'
import { getBio } from '@salvatorelaspata/content/bio'
import type { Alternates } from '../layouts/BaseLayout.astro'

interface Props {
  alternates: Alternates
}

const { alternates } = Astro.props
const lang = toLang(Astro.currentLocale)
const t = useT(lang)
const bio = getBio(lang)
const sections = mainNav(lang).filter(item => item.key !== 'blog')
const year = new Date().getFullYear()
const linkClass = 'link inline-flex min-h-[44px] items-center no-underline hover:underline'
---

<footer class='mt-section border-t-2 border-line'>
  <div class='palette-stripe' aria-hidden='true'><span></span><span></span><span></span><span></span><span></span></div>
  <div class='container-site grid gap-10 py-14 md:grid-cols-12'>
    <div class='md:col-span-5'>
      <a href={href('/', lang)} class='inline-flex min-h-[44px] items-center gap-3 rounded-sm text-ink no-underline'>
        <Logo /><span class='font-semibold'>{profile.fullName}</span>
      </a>
      <p class='mt-4 max-w-sm text-muted'>{bio.short}</p>
      <a class='btn btn-primary mt-6' href={sectionHref('contact', lang)}>
        <Icon name='calendar' size={18} />{t.common.book}
      </a>
    </div>
    <nav aria-labelledby='f-nav' class='md:col-span-2'>
      <h2 id='f-nav' class='label-mono'>{t.footer.sections}</h2>
      <ul class='mt-3'>
        {
          sections.map(item => (
            <li>
              <a class={linkClass} href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav aria-labelledby='f-more' class='md:col-span-2'>
      <h2 id='f-more' class='label-mono'>{t.footer.more}</h2>
      <ul class='mt-3'>
        <li><a class={linkClass} href={href('/blog/', lang)}>{t.nav.blog}</a></li>
        <li><a class={linkClass} href={href('/privacy/n8n', lang)}>{t.footer.privacy}</a></li>
        <li><a class={linkClass} href={href('/rss.xml', lang)}>{t.footer.rss}</a></li>
      </ul>
    </nav>
    <div class='md:col-span-3'>
      <h2 class='label-mono'>{t.footer.profiles}</h2>
      <ul class='mt-3 flex gap-2'>
        <li>
          <a class='btn btn-icon' href={profile.github} target='_blank' rel='noopener'>
            <Icon name='github' /><span class='sr-only'>GitHub{t.common.newTab}</span>
          </a>
        </li>
        <li>
          <a class='btn btn-icon' href={profile.linkedin} target='_blank' rel='noopener'>
            <Icon name='linkedin' /><span class='sr-only'>LinkedIn{t.common.newTab}</span>
          </a>
        </li>
        <li>
          <a class='btn btn-icon' href={mailto()}>
            <Icon name='mail' /><span class='sr-only'>{t.common.email}</span>
          </a>
        </li>
      </ul>
    </div>
  </div>
  <div class='border-t border-line-subtle'>
    <div class='container-site flex flex-col gap-4 py-6 text-step--1 text-muted sm:flex-row sm:items-center sm:justify-between'>
      <p>
        © {year} {profile.fullName} ·{' '}
        <a class='link' href='https://astro.build' target='_blank' rel='noopener'>
          {t.footer.builtWith}<span class='sr-only'>{t.common.newTab}</span>
        </a>{' '}
        ·{' '}
        <a class='link' href={profile.sourceRepo} target='_blank' rel='noopener'>
          {t.footer.source}<span class='sr-only'>{t.common.newTab}</span>
        </a>
      </p>
      <LangSwitch alternates={alternates} />
    </div>
  </div>
</footer>
