---
import Icon from './Icon.astro'
import StackDiagram from './StackDiagram.astro'
import { useT, toLang, sectionHref } from '../i18n'
import { profile, mailto } from '@salvatorelaspata/content/profile'
import { getBio } from '@salvatorelaspata/content/bio'

interface Props {
  projectCount: number
}

const { projectCount } = Astro.props
const lang = toLang(Astro.currentLocale)
const t = useT(lang)
const bio = getBio(lang)

const stats = [
  { value: profile.experienceYears, label: t.hero.stats.years },
  { value: profile.teamSize, label: t.hero.stats.team },
  { value: projectCount, label: t.hero.stats.projects },
  { value: profile.inRomeSince, label: t.hero.stats.rome },
]
---

<section data-hero class='container-site pb-16 pt-12 lg:pb-24 lg:pt-20' aria-labelledby='hero-title'>
  <div class='grid items-center gap-12 lg:grid-cols-12'>
    <div class='min-w-0 lg:col-span-7'>
      <p data-hero-text class='inline-flex items-center gap-2 font-mono text-step--1 text-muted'>
        <Icon name='pin' size={16} />{bio.kicker}
      </p>
      <h1 id='hero-title' data-hero-title class='t-display mt-5'>
        {bio.headline.before}<span class='font-mono font-medium tracking-[-0.04em] text-link'>{bio.headline.code}</span>{bio.headline.after}
      </h1>
      <p data-hero-text class='t-lead mt-6 max-w-[40rem]'>{bio.intro}</p>
      <div data-hero-text class='mt-8 flex flex-wrap gap-3'>
        <a class='btn btn-primary btn-lg' href={sectionHref('contact', lang)}><Icon name='calendar' />{t.common.book}</a>
        <a class='btn btn-lg' href={sectionHref('projects', lang)}>{t.hero.ctaProjects}<Icon name='arrow-right' /></a>
      </div>
      <ul data-hero-text class='mt-6 flex items-center gap-1' aria-label={t.hero.profiles}>
        <li>
          <a class='btn btn-ghost min-h-[44px] px-3' href={profile.github} target='_blank' rel='noopener'>
            <Icon name='github' size={18} />GitHub<span class='sr-only'>{t.common.newTab}</span>
          </a>
        </li>
        <li>
          <a class='btn btn-ghost min-h-[44px] px-3' href={profile.linkedin} target='_blank' rel='noopener'>
            <Icon name='linkedin' size={18} />LinkedIn<span class='sr-only'>{t.common.newTab}</span>
          </a>
        </li>
        <li>
          <a class='btn btn-ghost min-h-[44px] px-3' href={mailto()}><Icon name='mail' size={18} />{t.common.email}</a>
        </li>
      </ul>
    </div>
    <StackDiagram />
  </div>
  <dl class='mt-14 grid grid-cols-2 gap-x-6 gap-y-8 md:grid-cols-4'>
    {
      stats.map(s => (
        <div data-stat class='flex flex-col-reverse gap-1 border-l-2 border-line pl-4'>
          <dt class='text-step--1 text-muted'>{s.label}</dt>
          <dd class='font-mono text-step-3 font-semibold tracking-tight'>{s.value}</dd>
        </div>
      ))
    }
  </dl>
</section>
