---
import QRCode from 'qrcode'
import Icon from './Icon.astro'
import { useT, toLang, href } from '../i18n'
import { profile, mailto } from '@salvatorelaspata/content/profile'

const lang = toLang(Astro.currentLocale)
const t = useT(lang)

// Il QR punta all'URL assoluto del file .vcf: il testo completo della vCard (~470 byte)
// darebbe un QR versione 17 (85 moduli), illeggibile a 144px. L'URL resta a 33 moduli.
const vcfUrl = new URL(lang === 'en' ? `/en${profile.vcardPath}` : profile.vcardPath, profile.site).toString()
const qrSvg = await QRCode.toString(vcfUrl, {
  type: 'svg',
  errorCorrectionLevel: 'M',
  margin: 2,
  color: { dark: '#000000', light: '#ffffff' },
})
---

<li class='card flex flex-col gap-5 p-6 sm:flex-row lg:flex-col'>
  <div
    class='w-36 shrink-0 overflow-hidden rounded-sm border-2 border-line bg-white [&>svg]:block [&>svg]:h-full [&>svg]:w-full'
    role='img'
    aria-label={t.contact.qrLabel}
    data-qr={vcfUrl}
    set:html={qrSvg.replace('<svg', '<svg aria-hidden="true" focusable="false"')}
  />
  <div class='flex flex-col gap-3'>
    <h3 class='t-h4'>{t.contact.vcardTitle}</h3>
    <p class='text-step--1 text-muted'>{t.contact.vcardText}</p>
    <div class='flex flex-wrap gap-2'>
      <a class='btn' href={href(profile.vcardPath, lang)} download='salvatore-la-spata.vcf'>
        <Icon name='download' size={18} />{t.contact.vcardDownload}
      </a>
      <a class='btn btn-ghost' href={mailto()}><Icon name='mail' size={18} />{t.common.email}</a>
    </div>
  </div>
</li>
