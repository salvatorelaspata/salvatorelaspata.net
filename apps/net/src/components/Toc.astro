---
import { useT } from '../i18n'

interface Props {
  headings: { slug: string; text: string }[]
}

const { headings } = Astro.props
const t = useT(Astro.currentLocale)
const linkBase = 'block min-h-[44px] border-l-2 border-line-subtle py-2.5 pl-4 text-step--1 text-muted no-underline hover:text-ink'
---

{
  headings.length > 0 && (
    <aside class='min-w-0 lg:order-last lg:col-span-4 xl:col-span-3 xl:col-start-10' aria-label={t.article.tocLabel}>
      <details class='card p-4 lg:hidden'>
        <summary class='flex min-h-[44px] cursor-pointer items-center font-semibold'>{t.article.tocMobile}</summary>
        <ol class='mt-2'>
          {headings.map(h => (
            <li>
              <a class={linkBase} href={`#${h.slug}`}>
                {h.text}
              </a>
            </li>
          ))}
        </ol>
      </details>
      <nav class='hidden lg:sticky lg:top-28 lg:block' data-toc aria-labelledby='toc-t'>
        <h2 id='toc-t' class='label-mono mb-3'>
          {t.article.tocTitle}
        </h2>
        <ol>
          {headings.map(h => (
            <li>
              <a
                class={`${linkBase} aria-[current]:border-link aria-[current]:font-semibold aria-[current]:text-ink`}
                href={`#${h.slug}`}
              >
                {h.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </aside>
  )
}

<script>
  // Sezione attiva nell'indice (aria-current) mentre si scorre
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>('[data-toc] a[href^="#"]')
  if (tocLinks.length && 'IntersectionObserver' in window) {
    const map = new Map([...tocLinks].map(a => [decodeURIComponent(a.hash.slice(1)), a]))
    const io = new IntersectionObserver(
      entries => {
        entries.forEach(en => {
          if (!en.isIntersecting) return
          tocLinks.forEach(a => a.removeAttribute('aria-current'))
          map.get(en.target.id)?.setAttribute('aria-current', 'true')
        })
      },
      { rootMargin: '-20% 0px -70% 0px' },
    )
    map.forEach((_, id) => {
      const el = document.getElementById(id)
      if (el) io.observe(el)
    })
  }
</script>
