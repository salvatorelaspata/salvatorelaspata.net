---
import { profile } from '@salvatorelaspata/content/profile'

interface Props {
  size?: 'sm' | 'md'
}
const { size = 'md' } = Astro.props
const box = size === 'sm' ? 'w-9 h-9' : 'w-10 h-10'
---

<span
  class={`relative grid ${box} shrink-0 place-items-center overflow-hidden rounded-sm border-2 border-line bg-surface font-mono text-[0.8125rem] font-semibold shadow-brut-sm`}
  aria-hidden='true'
>
  {profile.initials}
  <span class='palette-stripe absolute inset-x-0 bottom-0 !h-[4px]'><span></span><span></span><span></span><span></span><span></span></span>
</span>
