---
import Icon from './Icon.astro'
import { useT } from '../i18n'
import type { Project } from '@salvatorelaspata/content/types'

interface Props {
  project: Pick<Project, 'github' | 'demo' | 'npm' | 'slides'>
  /** dentro una card con stretched link: i link restano sopra l'overlay */
  aboveLink?: boolean
  class?: string
}

const { project, aboveLink = false, class: className = '' } = Astro.props
const t = useT(Astro.currentLocale)

const links = [
  { url: project.github, label: t.projects.links.github, icon: 'github' },
  { url: project.npm, label: t.projects.links.npm, icon: 'package' },
  { url: project.demo, label: t.projects.links.demo, icon: 'play' },
  { url: project.slides, label: t.projects.links.slides, icon: 'slides' },
].filter(l => l.url) as { url: string; label: string; icon: 'github' | 'package' | 'play' | 'slides' }[]
---

{
  links.length > 0 && (
    <div class={`flex flex-wrap gap-1 ${className}`}>
      {links.map(l => (
        <a
          class={`btn btn-ghost min-h-[44px] px-3 text-step--1 ${aboveLink ? 'above-link' : ''}`}
          href={l.url}
          target='_blank'
          rel='noopener'
        >
          <Icon name={l.icon} size={18} />
          {l.label}
          <span class='sr-only'>{t.common.newTab}</span>
        </a>
      ))}
    </div>
  )
}
