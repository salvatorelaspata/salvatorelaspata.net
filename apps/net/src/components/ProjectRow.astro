---
import Icon from './Icon.astro'
import { useT, toLang, href } from '../i18n'
import type { Project } from '@salvatorelaspata/content/types'

interface Props {
  project: Project
}

const { project } = Astro.props
const lang = toLang(Astro.currentLocale)
const t = useT(lang)
---

<li
  data-filter-item='projects'
  data-tags={project.filters.join(' ')}
  class='relative grid grid-cols-[1fr_auto] items-center gap-x-4 gap-y-2 py-4 transition-colors hover:bg-surface md:grid-cols-[minmax(0,1.4fr)_9rem_minmax(0,1fr)_auto] md:px-3'
>
  <div class='min-w-0'>
    <a class='stretched-link font-semibold' href={href(`/projects/${project.slug}`, lang)}>{project.title}</a>
    <p class='truncate text-step--1 text-muted'>{project.summary}</p>
  </div>
  <p class='order-first col-span-2 font-mono text-step--1 text-muted md:order-none md:col-span-1'>
    {t.projects.kinds[project.kind]}
  </p>
  {
    project.technologies.length > 0 && (
      <ul class='col-span-2 row-start-3 flex flex-wrap gap-1.5 md:col-span-1 md:row-start-auto' aria-label={t.common.technologies}>
        {project.technologies.slice(0, 3).map(tech => (
          <li class='tag'>{tech}</li>
        ))}
      </ul>
    )
  }
  <span class='text-muted md:justify-self-end' aria-hidden='true'><Icon name='arrow-right' /></span>
</li>
