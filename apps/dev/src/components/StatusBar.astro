---
// Barra di stato in stile tmux: le "finestre" sono la navigazione principale.
import { useT, toLang, href, sectionHref, withBase, LANGS, type Lang } from '../i18n'

export type Window = 'home' | 'projects' | 'blog' | 'contact'

interface Props {
  alternates: Partial<Record<Lang, string>>
  current?: Window
}

const { alternates, current } = Astro.props
const lang = toLang(Astro.currentLocale)
const t = useT(lang)

const windows: { key: Window; label: string; href: string }[] = [
  { key: 'home', label: t.nav.home, href: href('/', lang) },
  { key: 'projects', label: t.nav.projects, href: sectionHref('projects', lang) },
  { key: 'blog', label: t.nav.blog, href: href('/blog/', lang) },
  { key: 'contact', label: t.nav.contact, href: sectionHref('contact', lang) },
]
---

<nav class='statusbar' aria-label={t.nav.label}>
  <span class='session' aria-hidden='true'>[sl]</span>
  <ul class='windows' role='list'>
    {
      windows.map((w, i) => (
        <li>
          <a href={w.href} aria-current={current === w.key ? 'page' : undefined}>
            <span class='num' aria-hidden='true'>
              {i}:
            </span>
            {w.label}
            {current === w.key && <span aria-hidden='true'>*</span>}
          </a>
        </li>
      ))
    }
  </ul>
  <div class='right'>
    <a href='#term-input' data-term-link hidden
      >&gt;_<span class='sr-only'> {t.nav.terminal}</span></a
    >
    {
      LANGS.map((l) =>
        alternates[l] ? (
          <a
            href={withBase(alternates[l])}
            hreflang={l}
            lang={l}
            aria-current={l === lang ? 'true' : undefined}
            title={t.common.langName[l]}
          >
            <span aria-hidden='true'>{l}</span>
            <span class='sr-only'>{t.common.langName[l]}</span>
          </a>
        ) : null
      )
    }
  </div>
</nav>
