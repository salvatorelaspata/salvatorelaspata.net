---
import BaseLayout from '../layouts/BaseLayout.astro'
import Icon from '../components/Icon.astro'
import { useT, href, type Lang } from '../i18n'

// Una sola 404 statica per tutto il sito: italiano, con una riga e un link in inglese.
const lang: Lang = 'it'
const t = useT(lang)
const en = useT('en')
---

<BaseLayout title={`${t.notFound.title} · Salvatore La Spata`} description={t.notFound.lead} noindex alternates={{}}>
  <div class='container-site pb-8 pt-16 lg:pt-24'>
    <div class='prose-site'>
      <p class='eyebrow not-prose'>404</p>
      <h1 class='t-h1'>{t.notFound.title}</h1>
      <p class='t-lead'>{t.notFound.lead}</p>
      <p lang='en' class='text-muted'>{en.notFound.title}. {en.notFound.lead}</p>
    </div>
    <div class='mt-8 flex flex-wrap gap-3'>
      <a class='btn btn-primary' href={href('/', lang)}><Icon name='arrow-left' size={18} />{t.notFound.home}</a>
      <a class='btn' href={href('/blog/', lang)}>{t.notFound.blog}<Icon name='arrow-right' size={18} /></a>
      <a class='btn btn-ghost' href={href('/', 'en')} lang='en' hreflang='en'>English home</a>
    </div>
  </div>
</BaseLayout>
