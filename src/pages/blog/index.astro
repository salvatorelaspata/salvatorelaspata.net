---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import HeaderSection from '../../layouts/HeaderSection.astro'
import CardBlog from '../../components/CardBlog.astro'
import BackButton from '../../components/ui/BackButton.astro'

const posts = (await getCollection('blog', e => e.data.lang === 'it' && !e.data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
---

<Layout title="salvatorelaspata.net - Blog" description="Articoli su sviluppo web, accessibilità e tecnologie SAP">
  <BackButton />
  <main class='min-h-screen max-w-6xl mx-auto px-5 py-12 bg-bg text-text'>
    <HeaderSection title="Blog" description="Articoli su sviluppo web, accessibilità e tecnologie" />
    <div class='grid gap-4 md:grid-cols-2 lg:grid-cols-3 mt-8'>
      {posts.map(post => (
        <CardBlog
          urlSlug={post.data.urlSlug}
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          cover={post.data.cover}
        />
      ))}
    </div>
  </main>
</Layout>
