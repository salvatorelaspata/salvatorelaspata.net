---
import BaseLayout from './BaseLayout.astro'
import Breadcrumb from '../components/Breadcrumb.astro'
import ProjectCover from '../components/ProjectCover.astro'
import ProjectLinks from '../components/ProjectLinks.astro'
import ProjectCard from '../components/ProjectCard.astro'
import CodeCopy from '../components/CodeCopy.astro'
import Icon from '../components/Icon.astro'
import { useT, toLang, fmt, href, sectionHref } from '../i18n'
import { getProjects, getRelatedProjects } from '../data/util'
import type { Project } from '../data/types'

interface Props {
  project: Project
}

const { project } = Astro.props
const lang = toLang(Astro.currentLocale)
const t = useT(lang)

const all = getProjects(lang)
const index = all.findIndex(p => p.slug === project.slug)
// l'elenco è dal più recente: "precedente" è il progetto più nuovo, "successivo" il più vecchio
const previous = index > 0 ? all[index - 1] : undefined
const next = index < all.length - 1 ? all[index + 1] : undefined
const related = getRelatedProjects(project, all)
const sharedFilter = related.length ? project.filters.find(f => related[0].filters.includes(f)) : undefined
const relatedTitle =
  sharedFilter && sharedFilter !== 'altro'
    ? fmt(t.projectPage.related, { filter: t.projects.filters[sharedFilter] })
    : t.projectPage.relatedGeneric

const ctas = [
  { url: project.github, label: t.projectPage.cta.github, icon: 'github' },
  { url: project.npm, label: t.projectPage.cta.npm, icon: 'package' },
  { url: project.demo, label: t.projectPage.cta.demo, icon: 'play' },
  { url: project.slides, label: t.projectPage.cta.slides, icon: 'slides' },
].filter(c => c.url) as { url: string; label: string; icon: 'github' | 'package' | 'play' | 'slides' }[]

const Content = project.Content
// filtri come tag di categoria, senza ripetere il tipo (es. "npm package" + "npm")
const categoryTags = project.filters
  .filter(f => f !== 'altro' && f !== (project.kind as string))
  .map(f => t.projects.filters[f])
---

<BaseLayout title={`${project.title} · Salvatore La Spata`} description={project.summary}>
  <div class='container-site pt-6'>
    <Breadcrumb
      items={[
        { label: t.common.home, href: href('/', lang) },
        { label: t.nav.projects, href: sectionHref('projects', lang) },
        { label: project.title },
      ]}
    />
  </div>
  <header class='container-site grid items-center gap-10 pb-14 pt-8 lg:grid-cols-12'>
    <div class='min-w-0 lg:col-span-7'>
      <ul class='flex flex-wrap gap-2' aria-label={t.projectPage.category}>
        <li class='tag tag-accent'>{t.projects.kinds[project.kind]}</li>
        {categoryTags.map(label => <li class='tag'>{label}</li>)}
      </ul>
      <h1 class='t-h1 mt-4'>{project.title}</h1>
      <p class='t-lead mt-5 max-w-[38rem]'>{project.description}</p>
      {
        ctas.length > 0 && (
          <div class='mt-8 flex flex-wrap gap-3'>
            {ctas.map((c, i) => (
              <a class:list={['btn', i === 0 && 'btn-primary']} href={c.url} target='_blank' rel='noopener'>
                <Icon name={c.icon} size={18} />
                {c.label}
                <span class='sr-only'>{t.common.newTab}</span>
              </a>
            ))}
          </div>
        )
      }
    </div>
    <div class='min-w-0 lg:col-span-5'>
      <div class='overflow-hidden rounded-lg border-2 border-line shadow-brut-lg'>
        <ProjectCover slug={project.slug} icon={project.icon} img={project.img} alt={project.title} class='aspect-[16/10]' />
      </div>
    </div>
  </header>

  <div class='container-site grid gap-12 border-t border-line-subtle pt-12 lg:grid-cols-12'>
    <article class='prose-site min-w-0 lg:col-span-8'>
      {Content && <Content />}
    </article>
    <aside class='min-w-0 lg:col-span-4' aria-label={t.projectPage.asideLabel}>
      <div class='flex flex-col gap-6 lg:sticky lg:top-28'>
        <div class='card p-5'>
          <h2 class='label-mono'>{t.projectPage.sheet}</h2>
          <dl class='mt-4 grid grid-cols-[6.5rem_1fr] gap-x-4 gap-y-3 text-step--1'>
            <dt class='text-muted'>{t.projectPage.type}</dt>
            <dd>{t.projects.kinds[project.kind]}</dd>
            {
              project.technologies.length > 0 && (
                <>
                  <dt class='text-muted'>{t.projectPage.stack}</dt>
                  <dd>
                    <ul class='flex flex-wrap gap-1.5' aria-label={t.common.technologies}>
                      {project.technologies.map(tech => (
                        <li class='tag'>{tech}</li>
                      ))}
                    </ul>
                  </dd>
                </>
              )
            }
          </dl>
          <ProjectLinks project={project} class='mt-5 border-t border-line-subtle pt-4' />
        </div>
        <div class='rounded-lg border-2 border-line bg-accent-soft p-5 text-accent-ink'>
          <h2 class='t-h4'>{t.projectPage.ctaTitle}</h2>
          <p class='mt-2 text-step--1'>{t.projectPage.ctaText}</p>
          <a class='btn btn-primary mt-4' href={sectionHref('contact', lang)}><Icon name='calendar' size={18} />{t.common.book}</a>
        </div>
      </div>
    </aside>
  </div>

  <nav aria-label={t.projectPage.otherNav} class='container-site mt-16 grid gap-4 border-y-2 border-line py-6 sm:grid-cols-2'>
    {
      previous ? (
        <a class='group flex min-h-[44px] flex-col gap-1 rounded-sm no-underline' href={href(`/projects/${previous.slug}`, lang)}>
          <span class='inline-flex items-center gap-2 font-mono text-step--1 text-muted'>
            <Icon name='arrow-left' size={16} />
            {t.projectPage.previous}
          </span>
          <span class='font-semibold text-ink group-hover:text-link'>{previous.title}</span>
        </a>
      ) : (
        <span />
      )
    }
    {
      next && (
        <a
          class='group flex min-h-[44px] flex-col gap-1 rounded-sm no-underline sm:items-end sm:text-right'
          href={href(`/projects/${next.slug}`, lang)}
        >
          <span class='inline-flex items-center gap-2 font-mono text-step--1 text-muted'>
            {t.projectPage.next}
            <Icon name='arrow-right' size={16} />
          </span>
          <span class='font-semibold text-ink group-hover:text-link'>{next.title}</span>
        </a>
      )
    }
  </nav>

  {
    related.length > 0 && (
      <section class='container-site mt-16' aria-labelledby='rel-title'>
        <h2 id='rel-title' class='t-h3'>
          {relatedTitle}
        </h2>
        <ul class='mt-6 grid gap-6 md:grid-cols-3'>
          {related.map(p => (
            <ProjectCard project={p} headingLevel={3} />
          ))}
        </ul>
      </section>
    )
  }
  <CodeCopy />
</BaseLayout>
