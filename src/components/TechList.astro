---
import { useT, fmt } from '../i18n'
import { getTechnologies, TECH_CATEGORIES, defaultSvg, monoSvg } from '../data/util'

const t = useT(Astro.currentLocale)
const technologies = getTechnologies()
const total = TECH_CATEGORIES.reduce((n, c) => n + technologies[c].length, 0)
---

<section id={t.ids.stack} class='section' aria-labelledby='stack-title'>
  <div class='container-site'>
    <div class='flex flex-wrap items-end justify-between gap-6' data-reveal>
      <div class='max-w-2xl'>
        <p class='eyebrow'>{t.ids.stack}</p>
        <h2 id='stack-title' class='t-h2 mt-3'>{t.stack.title}</h2>
        <p class='t-lead mt-4'>{fmt(t.stack.lead, { n: total })}</p>
      </div>
    </div>
    <dl class='mt-10 divide-y divide-line-subtle border-y-2 border-line' data-reveal>
      {
        TECH_CATEGORIES.map(category => {
          const core = category === 'sap'
          return (
            <div
              class:list={['grid gap-3 py-5 md:grid-cols-[13rem_1fr] md:gap-6', core && '-mx-3 rounded px-3 md:-mx-5 md:px-5']}
              style={core ? 'background:var(--accent-soft)' : undefined}
            >
              <dt class='flex items-center gap-2 md:flex-col md:items-start'>
                <span class='font-semibold'>{t.stack.categories[category]}</span>
                <span class='font-mono text-step--1 text-muted'>{fmt(t.stack.count, { n: technologies[category].length })}</span>
                {core && <span class='tag border border-line bg-surface'>{t.stack.core}</span>}
              </dt>
              <dd>
                <ul class='flex flex-wrap gap-2'>
                  {technologies[category].map(tech =>
                    tech.learning ? (
                      <li class='tag tag-outline min-h-[36px] px-2.5'>
                        {tech.title}
                        <span class='text-muted'>· {t.stack.learning}</span>
                      </li>
                    ) : (
                      <li class='inline-flex min-h-[36px] items-center gap-2 rounded-sm border border-line-subtle bg-surface px-2.5 text-step--1'>
                        <span class='grid h-5 w-5 place-items-center' set:html={monoSvg(tech.svg || defaultSvg)} />
                        {tech.title}
                      </li>
                    ),
                  )}
                </ul>
              </dd>
            </div>
          )
        })
      }
    </dl>
  </div>
</section>
