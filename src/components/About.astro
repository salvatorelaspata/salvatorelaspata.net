---
import Icon from './Icon.astro'
import type { IconName } from '../lib/icons'
import { useT } from '../i18n'
import { getBio } from '../data/bio'

const t = useT(Astro.currentLocale)
const bio = getBio(Astro.currentLocale)
---

<section id={t.ids.about} class='section' aria-labelledby='about-title'>
  <div class='container-site'>
    <div class='grid gap-10 lg:grid-cols-12'>
      <div class='lg:col-span-5' data-reveal>
        <p class='eyebrow'>{t.ids.about}</p>
        <h2 id='about-title' class='t-h2 mt-3'>{bio.motto}</h2>
        <p class='t-lead mt-5'>{bio.summary}</p>
      </div>
      <ul class='grid gap-4 sm:grid-cols-2 lg:col-span-7' data-reveal-group>
        {
          bio.facts.map(card => (
            <li class='card flex flex-col gap-3 p-5'>
              <span class='grid h-10 w-10 place-items-center rounded-sm bg-accent-soft text-accent-ink'>
                <Icon name={card.icon as IconName} />
              </span>
              <h3 class='t-h4'>{card.title}</h3>
              <p class='text-muted'>{card.text}</p>
              {card.tags.length > 0 && (
                <ul class='mt-auto flex flex-wrap gap-1.5 pt-1'>
                  {card.tags.map(tag => (
                    <li class='tag'>{tag}</li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </div>
    <div class='mt-16' data-reveal>
      <h3 class='t-h3'>{t.about.skillsTitle}</h3>
      <div class='mt-6 grid gap-8 md:grid-cols-3'>
        {
          bio.skills.map(group => (
            <div class='min-w-0'>
              <h4 class='label-mono border-b-2 border-line pb-2'>{group.title}</h4>
              <ul class='mt-2 divide-y divide-line-subtle'>
                {group.items.map(item => (
                  <li class='flex gap-4 py-4'>
                    <span class='mt-0.5 text-link'>
                      <Icon name={item.icon as IconName} />
                    </span>
                    <div>
                      <p class='font-semibold'>{item.name}</p>
                      <p class='mt-0.5 text-step--1 text-muted'>{item.text}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
