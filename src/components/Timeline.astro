---
import Icon from './Icon.astro'
import { useT } from '../i18n'
import type { Experience } from '../data/types'

interface Props {
  experiences: Experience[]
}

const { experiences } = Astro.props
const t = useT(Astro.currentLocale)
// "07/2016" → "2016-07" per l'attributo datetime
const iso = (d: string) => d.split('/').reverse().join('-')
---

<!-- La barra di avanzamento sta fuori dalla <ol>: una lista può contenere solo <li> -->
<div class='relative min-w-0 lg:col-span-8'>
  <span class='timeline-progress' aria-hidden='true'></span>
  <ol class='timeline'>
  {
    experiences.map(exp => (
      <li class='timeline-item' data-current={exp.current ? '' : undefined}>
        <span class='timeline-dot' aria-hidden='true' />
        <p class='font-mono text-step--1 text-muted'>
          <time datetime={iso(exp.start)}>{exp.start}</time> —{' '}
          {exp.end ? <time datetime={iso(exp.end)}>{exp.end}</time> : <span class='tag tag-accent'>{t.experience.now}</span>}
        </p>
        <h3 class='t-h3 mt-2'>{exp.title}</h3>
        <p class='mt-1 font-medium'>
          {exp.company} <span class='text-muted'>· {exp.location}</span>
        </p>
        <p class='mt-3 max-w-prose text-muted'>{exp.summary}</p>
        {exp.tags.length > 0 && (
          <ul class='mt-4 flex flex-wrap gap-1.5' aria-label={t.common.skills}>
            {exp.tags.map(tag => (
              <li class='tag'>{tag}</li>
            ))}
          </ul>
        )}
        {exp.details.length > 0 && (
          <details class='disclosure mt-3'>
            <summary>
              <Icon name='chevron-right' size={18} class='chev' />
              {t.experience.details}
            </summary>
            <ul class='prose-site mt-2 text-muted'>
              {exp.details.map(d => (
                <li>{d}</li>
              ))}
            </ul>
          </details>
        )}
      </li>
    ))
  }
</ol>
</div>
