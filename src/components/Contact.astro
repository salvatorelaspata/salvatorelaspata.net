---
import BookingCard from './BookingCard.astro'
import VCard from './VCard.astro'
import { useT } from '../i18n'

const t = useT(Astro.currentLocale)
---

<section id={t.ids.contact} class='section' aria-labelledby='contact-title'>
  <div class='container-site'>
    <div class='max-w-2xl' data-reveal>
      <p class='eyebrow'>{t.ids.contact}</p>
      <h2 id='contact-title' class='t-h2 mt-3'>{t.contact.title}</h2>
      <p class='t-lead mt-4'>{t.contact.lead}</p>
    </div>
    <ul class='mt-10 grid gap-6 lg:grid-cols-3' data-reveal-group>
      {t.contact.bookings.map(b => <BookingCard kind={b.key as 'coffee' | 'roundtable'} {...b} />)}
      <VCard />
    </ul>
  </div>
</section>
