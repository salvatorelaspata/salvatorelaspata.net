---
import { ICONS, type IconName } from '../lib/icons'


interface Props {
  name: IconName
  size?: number
  class?: string
  strokeWidth?: number
}

const { name, size = 20, class: className, strokeWidth = 1.75 } = Astro.props
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox='0 0 24 24'
  fill='none'
  stroke='currentColor'
  stroke-width={strokeWidth}
  stroke-linecap='round'
  stroke-linejoin='round'
  aria-hidden='true'
  focusable='false'
  set:html={ICONS[name]}
/>
