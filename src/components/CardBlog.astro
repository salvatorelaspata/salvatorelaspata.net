---
import { getRelativeLocaleUrl } from 'astro:i18n'

interface Props {
  urlSlug: string
  title: string
  description: string
  pubDate: Date
  tags: string[]
  cover?: string
}

const { urlSlug, title, description, pubDate, tags, cover } = Astro.props
const { currentLocale } = Astro
const blogUrl = getRelativeLocaleUrl(currentLocale || 'it', 'blog')

const formattedDate = pubDate.toLocaleDateString(currentLocale === 'en' ? 'en-GB' : 'it-IT', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
---

<div
  class='relative border-2 border-border bg-palette1 hover:bg-palette5
    transition-[transform,background-color,box-shadow]
    hover:translate-x-[-4px] hover:translate-y-[-4px]
    hover:shadow-shadow hover:shadow-[4px_4px_0px_rgba(0,0,0,1)]'
>
  <a
    href={`${blogUrl}${urlSlug}`}
    class='absolute inset-0 z-10'
    aria-label={title}
  ></a>

  {cover && (
    <div class='overflow-hidden h-40'>
      <img
        src={cover.startsWith('/') ? cover : `/${cover}`}
        alt={title}
        class='w-full h-full object-cover'
      />
    </div>
  )}

  <div class='p-4 flex flex-col gap-3 bg-bg text-text'>
    <time datetime={pubDate.toISOString()} class='text-xs opacity-60'>
      {formattedDate}
    </time>
    <h3 class='font-bold text-lg leading-snug'>{title}</h3>
    <p class='text-sm opacity-80'>
      {description.length > 120 ? description.slice(0, 120) + '…' : description}
    </p>
    <div class='flex flex-wrap gap-2 mt-1'>
      {tags.map(tag => (
        <span class='text-xs border border-border px-2 py-0.5 rounded-full'>{tag}</span>
      ))}
    </div>
  </div>
</div>
