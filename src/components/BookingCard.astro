---
import Icon from './Icon.astro'
import { useT, toLang } from '../i18n'
import { calUrl } from '../data/profile'

interface Props {
  kind: 'coffee' | 'roundtable'
  audience: string
  duration: string
  title: string
  text: string
}

const { kind, audience, duration, title, text } = Astro.props
const lang = toLang(Astro.currentLocale)
const t = useT(lang)
---

<li class='card-interactive flex flex-col p-6'>
  <div class='flex items-center justify-between gap-3'>
    <p class='label-mono'>{audience}</p>
    <p class='inline-flex items-center gap-1.5 font-mono text-step--1 font-semibold'><Icon name='clock' size={16} />{duration}</p>
  </div>
  <h3 class='t-h3 mt-4'>{title}</h3>
  <p class='mt-3 text-muted'>{text}</p>
  <p class='mt-auto pt-6'>
    <a
      class='stretched-link inline-flex min-h-[44px] items-center gap-2 font-semibold text-link'
      href={calUrl(kind, lang)}
      target='_blank'
      rel='noopener'
    >
      {t.contact.bookOn}<Icon name='external' size={18} /><span class='sr-only'>{t.common.newTab}</span>
    </a>
  </p>
</li>
