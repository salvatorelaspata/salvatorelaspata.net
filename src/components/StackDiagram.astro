---
import { useT, fmt } from '../i18n'
import { profile } from '../data/profile'
import { getBio } from '../data/bio'

const t = useT(Astro.currentLocale)
const bio = getBio(Astro.currentLocale)
// Colori fissi (non seguono il tema): il diagramma è un'illustrazione della palette di brand
const layerStyles = [
  'background:#5EB2C2;color:#002B39',
  'background:#006B7A;color:#FFFFFF',
  'background:#002B39;color:#E6F3F5',
]
---

<figure class='min-w-0 lg:col-span-5' aria-labelledby='stack-cap'>
  <div class='rounded-lg border-2 border-line bg-surface p-3 shadow-brut-lg sm:p-4'>
    <div class='mb-3 flex items-center justify-between px-1 font-mono text-step--1 text-muted'>
      <span>{t.hero.stackFile}</span><span>{fmt(t.hero.stackMeta, { years: profile.experienceYears })}</span>
    </div>
    <ol class='grid gap-2'>
      {
        bio.stack.map((layer, i) => (
          <li data-layer class='rounded-sm px-4 py-3.5 sm:px-5' style={layerStyles[i]}>
            <div class='flex items-baseline justify-between gap-3 font-mono text-step--1'>
              <span>
                <span class='font-semibold'>{layer.id}</span> · {layer.name}
              </span>
              <span class='opacity-90'>{layer.note}</span>
            </div>
            <p class='mt-1 text-step-1 font-semibold leading-snug' set:html={layer.items.replaceAll(' · ', '&nbsp;· ')} />
          </li>
        ))
      }
    </ol>
  </div>
  <figcaption id='stack-cap' class='mt-4 text-step--1 text-muted'>{t.hero.stackCaption}</figcaption>
</figure>
