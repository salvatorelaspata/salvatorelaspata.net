---
import { useT, toLang, fmt, formatDate } from '../i18n'
import { postHref, readingTime, tagSlug, type Post } from '../lib/blog'

interface Props {
  post: Post
  /** per l'indice del blog: la card diventa filtrabile */
  filterGroup?: string
}

const { post, filterGroup } = Astro.props
const lang = toLang(Astro.currentLocale)
const t = useT(lang)
const { title, description, pubDate, tags } = post.data
---

<li
  class='card-interactive flex flex-col p-5 sm:p-6'
  data-filter-item={filterGroup}
  data-tags={filterGroup ? tags.map(tagSlug).join(' ') : undefined}
>
  <p class='flex items-center gap-3 font-mono text-step--1 text-muted'>
    <time datetime={pubDate.toISOString().slice(0, 10)}>{formatDate(pubDate, lang)}</time>
    <span aria-hidden='true'>·</span>
    <span>{fmt(t.common.minRead, { n: readingTime(post) })}</span>
  </p>
  <h3 class='t-h4 mt-3'><a class='stretched-link' href={postHref(post)}>{title}</a></h3>
  <p class='mt-2 text-muted'>{description}</p>
  {
    tags.length > 0 && (
      <ul class='mt-auto flex flex-wrap gap-1.5 pt-5' aria-label={t.common.topics}>
        {tags.map(tag => (
          <li class='tag tag-accent'>{t.blog.tags[tag]}</li>
        ))}
      </ul>
    )
  }
</li>
