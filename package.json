{
  "name": "salvatorelaspata",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @salvatorelaspata/net",
    "dev:host": "npm run dev:host -w @salvatorelaspata/net",
    "start": "npm run dev",
    "build": "npm run check -w @salvatorelaspata/content && npm run build --workspaces --if-present",
    "build:net": "npm run build -w @salvatorelaspata/net",
    "test": "npm test --workspaces --if-present",
    "check:contrast": "npm run check:contrast --workspaces --if-present",
    "lint": "eslint apps/*/src packages/*/src",
    "lint:fix": "eslint apps/*/src packages/*/src --fix",
    "format": "prettier --write apps/*/src packages/*/src",
    "format:check": "prettier --check apps/*/src packages/*/src"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-astro": "^1.7.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.0"
  }
}
